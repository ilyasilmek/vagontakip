# Do not put real credentials in this tracked example.
# Local development: create .dev.vars (ignored) using npm run setup:local.
# Production: set secrets on the Cloudflare Worker, never in client source.
STORAGE_MODE=github
GITHUB_REPOSITORY=ilyasilmek/vagontakip
GITHUB_BRANCH=main
GITHUB_DATABASE_PATH=data/database.enc.json
ADMIN_USERNAME=admin
# Required Worker secrets: ADMIN_PASSWORD, SESSION_SECRET, DB_ENCRYPTION_KEY, GITHUB_TOKEN
# Required deployment environment: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
