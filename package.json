{
  "name": "vagon-takip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node scripts/wrangler.mjs dev --local --port 8787 --persist-to .local/worker-state",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && node scripts/wrangler.mjs deploy",
    "typecheck": "tsc --noEmit",
    "import:sqlite": "python3 scripts/import_sqlite.py",
    "data:encrypt": "tsx scripts/encrypt-data.ts",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}
